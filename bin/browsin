#!/usr/bin/env node

// Node 22+ is the whole dependency list: the CDP client is built on the global
// WebSocket, which older Node does not have. Checked here because the failure
// otherwise surfaces as `WebSocket is not defined` deep in the client, which
// reads like a bug in browsin instead of the wrong interpreter.
const major = Number(process.versions.node.split('.')[0]);
if (major < 22 || typeof WebSocket === 'undefined') {
  console.error(
    `browsin needs Node 22+ (running ${process.versions.node}${
      typeof WebSocket === 'undefined' ? ', no global WebSocket' : ''
    }).\n  nvm use 22   |   brew install node`,
  );
  process.exit(1);
}

const c = await import('../src/commands.mjs');
const fs = await import('node:fs');

const BOOLEAN = new Set(['full', 'mobile', 'all', 'no-snap', 'no-wait', 'no-background', 'help', 'version', 'landscape',
  'jpeg', 'hard', 'fresh', 'net', 'failed', 'onscreen', 'append', 'enter', 'css-page-size', 'keep-frames']);

const camel = (s) => s.replace(/-([a-z])/g, (_, ch) => ch.toUpperCase());

const parse = (argv) => {
  const args = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const tok = argv[i];
    if (tok === '--') { args._.push(...argv.slice(i + 1)); break; }
    if (tok.startsWith('--')) {
      const [rawKey, inline] = tok.slice(2).split(/=(.*)/s);
      // Boolean flag names stay verbatim so `--no-snap` reads as written.
      const key = BOOLEAN.has(rawKey) ? rawKey : camel(rawKey);
      if (inline !== undefined) args[key] = inline;
      else if (BOOLEAN.has(rawKey)) args[key] = true;
      else if (argv[i + 1] !== undefined && !argv[i + 1].startsWith('--')) args[key] = argv[++i];
      else args[key] = true;
      continue;
    }
    if (tok === '-o') { args.o = argv[++i]; continue; }
    if (tok === '-h') { args.help = true; continue; }
    if (tok === '-v') { args.version = true; continue; }
    args._.push(tok);
  }
  // `--css-page-size` is read as cssPageSize by the command.
  if (args['css-page-size']) args.cssPageSize = true;
  return args;
};

const COMMANDS = {
  check: c.cmdCheck, open: c.cmdOpen, reload: c.cmdReload, back: c.cmdBack,
  snapshot: c.cmdSnapshot, dom: c.cmdDom, text: c.cmdText, js: c.cmdJs, logs: c.cmdLogs, network: c.cmdNetwork,
  snap: c.cmdSnap, pdf: c.cmdPdf,
  click: c.cmdClick, hover: c.cmdHover, type: c.cmdType, key: c.cmdKey, select: c.cmdSelect,
  upload: c.cmdUpload, download: c.cmdDownload, drag: c.cmdDrag, scroll: c.cmdScroll,
  viewport: c.cmdViewport, login: c.cmdLogin, status: c.cmdStatus, doctor: c.cmdDoctor,
  tabs: c.cmdTabs, record: c.cmdRecord, gc: c.cmdGc, down: c.cmdDown,
};

const ALIASES = { snaps: 'snapshot', ss: 'snapshot', shot: 'snap', screenshot: 'snap', pic: 'snap',
  eval: 'js', txt: 'text', stop: 'down', quit: 'down' };

const USAGE = `browsin — headless browser for coding agents. Text first, pixels on request.

navigate   check <url|file>      navigate + problems + network + screenshot, one call
           open <url|file>       navigate and report
           reload [--hard] · back
observe    snapshot              what is on screen, as actionable selectors  <- start here
           dom <sel>             rect, visibility, computed styles, html
           text [sel]            innerText of the element (default body), normalised, --limit N
           js '<expr>'           evaluate in the page
           logs [--all]          console, exceptions, failed fetch/XHR
           network [url]         every request with its status code
capture    snap [--clip SEL] [--full] [--jpeg]     screenshot (default: viewport, 1x)
           pdf [url] [--format a4|a3|letter] [--landscape]
act        click <sel> · hover <sel> · type <sel> <text> [--enter]
           key <Enter|Tab|Escape|ArrowDown|…> [--mod cmd,shift] [--on SEL]
           select <sel> <value|label> · upload <sel> <file…>
           download <sel> [--dir path]          click and wait for the file
           drag <fromSel> <toSel> | drag <sel> --by dx,dy
           scroll <y|top|bottom|selector>
           tabs [list] · tabs use N · tabs close N · tabs auto
manage     viewport [1280x800|iphone|ipad|desktop|wide] [--dpr N] [--mobile]
           login [url] [--note "why"]     visible window to sign in by hand, once; --note shows an
                                  interstitial first, explaining to the user why the window opened
           status · doctor · gc · down [--fresh] [--all]
record     record start [--name X] [--fps N] [--quality N] [--max-seconds N|0]
           record status · record stop [-o path.gif|path.mp4] [--max-gap s] [--keep-frames]
           record cancel         one frame per visual command; gif|mp4 assembled at stop

Selectors accept CSS, or "text=Entrar" to address an element by what the user
reads. Both pierce shadow DOM.

Flags: --wait '<expr>'  --timeout ms  --dpr N  --nth N  --clip SEL --pad px  --full
       --max-height px  --jpeg --quality N  --html N  --name NAME  -o path
       --format F --landscape --margin in --scale N --no-background --css-page-size
       --mod cmd,shift  --on SEL  --by dx,dy  --steps N  --limit N  --onscreen
       --append  --enter  --net  --all  --no-snap  --no-wait  --hard  --fresh
       --fps N  --max-seconds N  --max-gap s  --keep-frames

Never touches your real Chrome: headless shell, throwaway profile in /tmp/browsin.
One browser per session (BROWSIN_SESSION, else PI_SESSION_ID, else "default"); sessions
idle past BROWSIN_TTL_MIN (default 60) are reaped automatically — see browsin gc.
Commands in the same session are serialized: a parallel browsin waits its turn instead of
spawning a second browser or reading the page the first one navigated.`;

// Levenshtein over the command + alias list, so a typo gets a nudge instead of
// a wall of usage text. Suggests only when close (<= 2 edits).
const editDistance = (a, b) => {
  const row = Array.from({ length: b.length + 1 }, (_, i) => i);
  for (let i = 1; i <= a.length; i++) {
    let carry = row[0]; row[0] = i;
    for (let j = 1; j <= b.length; j++) {
      const tmp = row[j];
      row[j] = Math.min(row[j] + 1, row[j - 1] + 1, carry + (a[i - 1] === b[j - 1] ? 0 : 1));
      carry = tmp;
    }
  }
  return row[b.length];
};

const suggestCommand = (word) => {
  const candidates = [...Object.keys(COMMANDS), ...Object.keys(ALIASES)];
  let best = null, bestD = Infinity;
  for (const cand of candidates) {
    const d = editDistance(word.toLowerCase(), cand.toLowerCase());
    if (d < bestD) { bestD = d; best = cand; }
  }
  return bestD <= 2 ? best : null;
};

const [firstArg, ...rest] = process.argv.slice(2);
// help/version may arrive as the first token itself, not as a flag of a command.
const HELP_TOKENS = new Set(['help', '--help', '-h']);
const VERSION_TOKENS = new Set(['--version', '-v']);
const rawName = HELP_TOKENS.has(firstArg) || VERSION_TOKENS.has(firstArg) ? undefined : firstArg;
const name = ALIASES[rawName] || rawName;
const args = parse(rest);

// An agent often pastes a whole snapshot line, so `--nth N` can arrive glued to
// the selector: `click 'text=Entrar --nth 1'`. Peel it off into the flag the
// commands already read, so the pasted line works instead of a confusing
// "no match". Only on the selector-bearing positionals (never on `type` text).
const peelNth = (v) => {
  if (typeof v !== 'string') return null;
  const m = /\s+--nth(?:=|\s+)(\d+)\s*$/.exec(v);
  return m ? { value: v.slice(0, m.index), nth: Number(m[1]) } : null;
};
for (const key of ['clip', 'on']) {
  const p = peelNth(args[key]);
  if (p) { args[key] = p.value; if (args.nth === undefined) args.nth = p.nth; }
}
if (typeof args._[0] === 'string') {
  const p = peelNth(args._[0]);
  if (p) { args._[0] = p.value; if (args.nth === undefined) args.nth = p.nth; }
}

if (args.version || VERSION_TOKENS.has(firstArg)) {
  const { version } = JSON.parse(fs.readFileSync(new URL('../package.json', import.meta.url), 'utf8'));
  console.log(`browsin ${version}`);
  process.exit(0);
}

if (!name || name === 'help' || args.help) {
  console.log(USAGE);
  process.exit(name && name !== 'help' && !HELP_TOKENS.has(firstArg) ? 1 : 0);
}

const fn = COMMANDS[name];
if (!fn) {
  // The first arg may be the target itself, mistyped as a command: a URL
  // ("localhost:5173", "http://…") or a path that exists on disk.
  if (/:\/\//.test(rawName) || /^\w+:\d+/.test(rawName) || fs.existsSync(rawName)) {
    console.error(`browsin: "${rawName}" looks like a URL or file, not a command
  try: browsin check ${rawName}   (or: browsin open ${rawName})`);
  } else {
    const sug = suggestCommand(rawName);
    const resolved = sug && ALIASES[sug] ? ` (alias for ${ALIASES[sug]})` : '';
    console.error(`browsin: unknown command "${rawName}"${sug ? `\n  did you mean "browsin ${sug}"?${resolved}` : ''}
  run browsin --help for the command list`);
  }
  process.exit(1);
}

try {
  const out = await fn(args);
  if (out) console.log(out);
  process.exit(0);
} catch (err) {
  console.error(`browsin ${name}: ${err.message}`);
  process.exit(1);
}
